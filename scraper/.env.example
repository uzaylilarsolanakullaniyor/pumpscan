# Scraper ortam değişkenleri (GitHub Secrets olarak da tanımlanır)
# Yerel test için bu dosyayı .env olarak kopyalayıp doldurun:
#   cp .env.example .env

# Supabase proje URL'i (Settings > API > Project URL)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# service_role key — RLS bypass eder, GİZLİ tutun, frontend'e koymayın!
# (Settings > API > service_role secret)
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Opsiyonel ayarlar (config.js varsayılanlarını geçersiz kılar) ---
# MIN_LIQUIDITY_USD=5000
# MIN_VOLUME_24H=10000
# MAX_AGE_DAYS=30
# MAX_TOKENS_PER_RUN=120
# DEBUG=1
