# Frontend ortam değişkenleri (Vercel'de de tanımlanır)
# Yerel geliştirme için bu dosyayı .env.local olarak kopyalayın:
#   cp .env.local.example .env.local

# Supabase proje URL'i (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# anon (public) key — sadece okuma. RLS politikası yazmayı engeller.
# (Settings > API > Project API keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
